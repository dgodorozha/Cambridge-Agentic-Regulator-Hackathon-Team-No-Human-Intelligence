# Copy to .env and export, or set in the process manager.
HSL_HOST=127.0.0.1
HSL_PORT=8050
HSL_RUNS_DIR=runs
HSL_SECRET=replace-with-64-hex-chars-from-the-secret-store
HSL_AUTH_MODE=open          # header in production
HSL_USER_HEADER=X-Remote-User
HSL_APPROVERS=              # e.g. r.ahmed,s.gabrielli
HSL_FOUR_EYES=1
HSL_LLM=auto                # off to forbid outbound model calls
# ANTHROPIC_API_KEY=
HSL_MODEL=claude-sonnet-4-6
HSL_TICK_PACE=0.0008
HSL_ASK_RATE=20
HSL_ASSURANCE=full          # light for a short demo run
HSL_SEEDS=3                 # seeds per herding family (2 for a short demo)

# Model provider (optional). off is the default; every path is deterministic without one.
# HSL_LLM_PROVIDER=anthropic      ANTHROPIC_API_KEY=...            HSL_MODEL=claude-sonnet-4-6
# HSL_LLM_PROVIDER=openai         HSL_LLM_BASE=https://gateway.your-institution/v1   HSL_LLM_MODEL=your-model   HSL_LLM_KEY=...
# HSL_LLM_PROVIDER=openai         HSL_LLM_BASE=http://127.0.0.1:11434/v1             HSL_LLM_MODEL=llama3       (a local server; loopback may use http)
# HSL_LLM_PROVIDER=local          HSL_LLM_PATH=/models/your-model   (a directory you installed; pip install transformers torch)
# HSL_LLM_PROVIDER=azure          HSL_LLM_BASE=https://<resource>.openai.azure.com  HSL_LLM_MODEL=<deployment>  HSL_LLM_KEY=...   (Copilot's platform)
# HSL_LLM_PROVIDER=gemini         HSL_LLM_MODEL=gemini-2.0-flash  HSL_LLM_KEY=...
# HSL_LLM_PROVIDER=custom         HSL_LLM_BASE=https://models.your-institution/ask
#   HSL_LLM_TEMPLATE='{"input": {"question": "{prompt}", "context": "{system}"}, "max": {max_tokens}}'
#   HSL_LLM_HEADERS='{"Authorization": "Bearer ${HSL_LLM_KEY}"}'   HSL_LLM_RESPONSE_PATH=result.answer.text
