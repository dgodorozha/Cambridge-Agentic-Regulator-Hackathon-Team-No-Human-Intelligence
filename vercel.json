{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "HSL_ASSURANCE": "demo",
    "HSL_DEV_MODE": "on",
    "HSL_RUNS_DIR": "/tmp/hsl_runs"
  }
}
